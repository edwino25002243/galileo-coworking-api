generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int       @id @default(autoincrement())
  name  String    @unique @db.VarChar(50)
  users Usuario[]

  @@map("roles")
}

model WorkplaceType {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(50)
  workplaces Workplace[]

  @@map("workplace_types")
}

model Usuario {
  id            Int       @id @default(autoincrement())
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password      String    @db.VarChar(255)
  personalId    String    @unique @map("personal_id") @db.VarChar(50)
  paymentMethod String?   @map("payment_method") @db.VarChar(50)
  dateOfBirth   DateTime  @map("date_of_birth") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  roleId        Int       @map("fk_role_id")
  role          Role      @relation(fields: [roleId], references: [id])
  reservas      Reserva[]

  @@map("usuarios")
}

model Workplace {
  id             Int                @id @default(autoincrement())
  name           String             @db.VarChar(150)
  location       String             @db.VarChar(255)
  description    String?            @db.Text
  pricePerHour   Decimal            @map("price_per_hour") @db.Decimal(10, 2)
  capacity       Int?
  isActive       Boolean            @default(true) @map("is_active")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  typeId         Int                @map("fk_workplace_type_id")
  type           WorkplaceType      @relation(fields: [typeId], references: [id])
  reservas       Reserva[]
  images         WorkplaceImage[]
  amenities      WorkplaceAmenity[]

  @@map("workplaces")
}

model Reserva {
  id          Int       @id @default(autoincrement())
  date        DateTime  @db.Date
  startTime   DateTime  @map("start_time") @db.Time
  endTime     DateTime  @map("end_time") @db.Time
  totalPrice  Decimal   @map("total_price") @db.Decimal(10, 2)
  status      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  userId      Int       @map("fk_user_id")
  workplaceId Int       @map("fk_workplace_id")
  user        Usuario   @relation(fields: [userId], references: [id])
  workplace   Workplace @relation(fields: [workplaceId], references: [id])

  @@map("reservas")
}

model Amenity {
  id         Int                @id @default(autoincrement())
  name       String             @unique @db.VarChar(100)
  workplaces WorkplaceAmenity[]

  @@map("amenities")
}

model WorkplaceAmenity {
  workplaceId Int       @map("fk_workplace_id")
  amenityId   Int       @map("fk_amenity_id")
  workplace   Workplace @relation(fields: [workplaceId], references: [id])
  amenity     Amenity   @relation(fields: [amenityId], references: [id])

  @@id([workplaceId, amenityId])
  @@map("workplace_amenities")
}

model WorkplaceImage {
  id          Int       @id @default(autoincrement())
  imageUrl    String    @map("image_url") @db.Text
  isMain      Boolean   @default(false) @map("is_main")
  workplaceId Int       @map("fk_workplace_id")
  workplace   Workplace @relation(fields: [workplaceId], references: [id])

  @@map("workplace_images")
}